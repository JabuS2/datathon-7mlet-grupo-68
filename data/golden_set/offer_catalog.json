{
  "catalog_metadata": {
    "version": "2.0.0",
    "description": "Catálogo de ofertas — fonte única de verdade dos 10 braços do MAB (Datathon 7MLET Grupo 68).",
    "n_arms": 10,
    "reward_definition": {
      "type": "composite",
      "formula": "alpha * (expected_revenue_brl / v_max) + beta * conversion",
      "alpha": 0.6,
      "beta": 0.4,
      "v_max": 7000,
      "note": "conversion = transição 0→1 da br_product_column (real) ou simulada via synthetic_simulation.",
      "synthetic_note": "conversao = base_conversion_rate * prod(segment_multipliers ativos) * (1 + sum(context_modulators_k * z_k)), onde z_k e o valor padronizado (z-score) da feature; fator clipado em [0.3, 2.2]; event_trigger sobrepoe a base. Moduladores criam variacao intra-segmento que so um modelo contextual (LinUCB) captura."
    },
    "data_source": {
      "golden_sample_file": "data/golden_set/golden_clients.csv",
      "full_dataset_file": "data/synthetic_enrichment/clientes_br_sintetico.csv",
      "client_id_column": "cod_cliente",
      "date_column": "data_referencia",
      "loader_pattern": {
        "step_1_filter": "eligible_segment.santander_filters",
        "step_2_context": "context_features",
        "step_3_reward": "santander_mapping.br_product_column"
      }
    },
    "filter_conventions": {
      "_atual": "valor atual da coluna binária de produto (ex: possui_cartao_credito_atual: 0)",
      "_min": "valor mínimo inclusive",
      "_percentil_min": "percentil mínimo da renda",
      "idade_min/max": "faixa etária elegível",
      "sem_sufixo": "igualdade direta"
    },
    "br_column_mapping": {
      "ind_ahor_fin_ult1": "possui_poupanca",
