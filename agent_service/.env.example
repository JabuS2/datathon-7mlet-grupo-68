# Service
HOST=0.0.0.0
PORT=8100
AGENT_NAME=admin_dashboard_agent
AGENT_PATH=/
CORS_ORIGINS=["http://localhost:3000"]

# LLM (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-4o-mini

# MCP server (JavaScript)
MCP_SERVER_URL=http://localhost:8200/mcp
# Admin JWT / service token forwarded downstream for data access
DOWNSTREAM_API_TOKEN=

# JWT validation of incoming admin requests (must match api_service)
SECRET_KEY=your_secret_key
ALGORITHM=HS256
REQUIRE_AUTH=true
