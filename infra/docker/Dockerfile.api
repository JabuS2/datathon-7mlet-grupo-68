FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VIRTUALENVS_CREATE=false

WORKDIR /app

RUN pip install --no-cache-dir poetry

COPY api_service/pyproject.toml api_service/poetry.lock* ./

# Somente dependências de produção (sem grupos de teste/lint) → imagem menor.
RUN poetry install --only main --no-interaction --no-ansi

COPY api_service/ .

COPY infra/docker/entrypoint.api.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Executa como usuário não-root (o entrypoint roda migração + seed, que não exigem root).
RUN useradd --create-home --uid 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# O entrypoint espera o Postgres, migra, semeia (SEED_DB) e sobe o uvicorn sob
# ddtrace-run (instrumentação Datadog) sem --reload. Sem DD_TRACE_ENABLED=true
# (default do compose é false) o ddtrace não tenta conectar ao agent.
ENTRYPOINT ["/app/entrypoint.sh"]
