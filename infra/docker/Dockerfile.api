FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VIRTUALENVS_CREATE=false

WORKDIR /app

RUN pip install --no-cache-dir poetry

COPY api_service/pyproject.toml api_service/poetry.lock* ./

RUN poetry install --no-interaction --no-ansi

COPY api_service/ .

EXPOSE 8000

# ddtrace-run instrumenta a app para o Datadog. Sem DD_TRACE_ENABLED=true (default
# do compose é false) ele não tenta conectar ao agent — não afeta itens 1-6.
CMD ["ddtrace-run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]