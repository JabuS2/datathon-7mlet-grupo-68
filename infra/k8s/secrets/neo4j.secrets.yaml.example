apiVersion: v1
kind: Secret
metadata:
  name: neo4j-secret
  namespace: datathon
type: Opaque
stringData:
  # Consumed by the bitnami/neo4j chart (auth.existingSecretPasswordKey: NEO4J_PASSWORD)
  # and by the API deployment (NEO4J_USER + NEO4J_PASSWORD).
  NEO4J_USER: "neo4j"
  NEO4J_PASSWORD: "change_me"
