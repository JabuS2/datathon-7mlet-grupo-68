apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: datathon
type: Opaque
stringData:
  # Replace with real values before applying
  SECRET_KEY: "change_me_to_a_long_random_string"
  PGADMIN_DEFAULT_EMAIL: "admin@yourdomain.com"   # must be a real domain (not .local)
  PGADMIN_DEFAULT_PASSWORD: "change_me"
  ANTHROPIC_API_KEY: ""
  OPENAI_API_KEY: ""
