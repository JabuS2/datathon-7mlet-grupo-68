# Public URL of the api_service (used by the browser for login/me)
NEXT_PUBLIC_API_SERVICE_URL=http://localhost:8000
# Server-side URL of the agent_service AG-UI endpoint (used by the runtime route)
AGENT_SERVICE_URL=http://localhost:8100/
# Name of the agent as registered in agent_service (AGENT_NAME there)
NEXT_PUBLIC_AGENT_NAME=admin_dashboard_agent
