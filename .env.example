# API
PROJECT_NAME="HP Invest API"
VERSION="1.0.0"
DESCRIPTION="API for HP Invest"
# development | staging | production  (em produção, SECRET_KEY fraco é rejeitado no boot)
ENVIRONMENT="development"
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://localhost:3000"]  # Rotas que podem acessar a API
API_PORT=8001

### Database
# Opcional: se definida, tem precedência sobre os POSTGRES_* abaixo (útil no Docker/Compose).
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres"
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres"
POSTGRES_PORT=5432
SQLALCHEMY_ECHO=false

# MLflow (rastreio de experimentos — governança)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=datathon-mab

# Bandit
BANDIT_BATCH_WINDOW_DAYS=7
BANDIT_REWARD_HORIZON_DEFAULT=30

# Model Service (bandits)
MODEL_SERVICE_URL=http://localhost:8002
# Database PRÓPRIO do model_service (governança). Mesma instância Postgres, outro
# database: duas cadeias Alembic num só database disputam `alembic_version`.
MODEL_POSTGRES_DB=model_service
DEFAULT_ALGORITHM=linucb
CATALOG_PATH=data/golden_set/offer_catalog.json
CLIENTS_CSV_PATH=data/golden_set/golden_clients.csv

# Frontends
VITE_API_URL=http://localhost:8000

# ── Admin Assistant stack (dashboard + agent + mcp) ────────────
# Browser-facing api_service URL (host-accessible; api is published on 8001)
NEXT_PUBLIC_API_SERVICE_URL=http://localhost:8001
# Agent name shared by agent_service and the dashboard
AGENT_NAME=admin_dashboard_agent
# OpenAI model spec for the deep agent
OPENAI_MODEL=openai:gpt-4o-mini
# Admin JWT / service token the agent forwards downstream for data access
DOWNSTREAM_API_TOKEN=
# Origins allowed to call the agent AG-UI endpoint
AGENT_CORS_ORIGINS=["http://localhost:3000"]

# Text-to-SQL widget (mcp_server queries Postgres directly, SELECT-only role —
# see infra/docker/initdb/02-readonly-role.sh). Set READONLY_DB_PASSWORD to enable it.
READONLY_DB_USER=readonly_reporting
READONLY_DB_PASSWORD=

# Security
# Gere um segredo forte (>= 32 chars), ex.: `openssl rand -hex 32`. NÃO use o default em produção.
SECRET_KEY="troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redis_password"
REDIS_DB=0

# OpenSearch e Neo4j — NÃO PROVISIONADOS
# Sobraram de um desenho anterior (RAG + grafo). Não há serviço no docker-compose nem
# consumidor no código; as chaves seguem declaradas em api_service/settings.py só para
# não quebrar .env antigos. Remova este bloco quando o desenho for descartado de vez.
OPENSEARCH_HOST="localhost"
OPENSEARCH_PORT=9200
OPENSEARCH_USER="admin"
OPENSEARCH_ADMIN_PASSWORD="Datathon#7Mlet!2026"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="neo4j_password"

# pgAdmin
PGADMIN_EMAIL="admin@datathon.com"
PGADMIN_PASSWORD="pgadmin_password"

# Datadog (observabilidade) — ver docs/observability-datadog.md
# Deixe DD_TRACE_ENABLED=false até criar a conta e preencher DD_API_KEY.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=dev
DD_TRACE_ENABLED=false
