# API
PROJECT_NAME="HP Invest API"
VERSION="1.0.0"
DESCRIPTION="API for HP Invest"
# development | staging | production  (em produção, SECRET_KEY fraco é rejeitado no boot)
ENVIRONMENT="development"
BACKEND_CORS_ORIGINS=["http://localhost:4200"]  # Rotas que podem acessar a API
API_PORT=8001

### Database
# Opcional: se definida, tem precedência sobre os POSTGRES_* abaixo (útil no Docker/Compose).
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres"
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres"
POSTGRES_PORT=5432
SQLALCHEMY_ECHO=false

# MLflow (rastreio de experimentos — governança)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=datathon-mab

# Frontend
VITE_API_URL=http://localhost:8000

# Security
# Gere um segredo forte (>= 32 chars), ex.: `openssl rand -hex 32`. NÃO use o default em produção.
SECRET_KEY="troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redis_password"
REDIS_DB=0

# OpenSearch (infra do compose)
OPENSEARCH_HOST="localhost"
OPENSEARCH_PORT=9200
OPENSEARCH_USER="admin"
OPENSEARCH_ADMIN_PASSWORD="Admin@OpenSearch1"

# Neo4j (infra do compose)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="neo4j_password"

# pgAdmin
PGADMIN_EMAIL="admin@datathon.local"
PGADMIN_PASSWORD="pgadmin_password"

# Nota: o assistente LLM + RAG é uma API SEPARADA — suas chaves (ANTHROPIC/OPENAI, vector store)
# ficam no .env daquele serviço, não aqui.
