# API
PROJECT_NAME="HP Invest API"
VERSION="1.0.0"
DESCRIPTION="API for HP Invest"
BACKEND_CORS_ORIGINS=["http://localhost:4200"]  # Rotas que podem acessar a API
API_PORT=8001

### Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres"
POSTGRES_PORT=5432

# LLM (escolha um)
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
LLM_MODEL=claude-sonnet-4-20250514

# Vector Store (RAG)
CHROMA_PERSIST_DIR=./data/vector_store

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=datathon-mab

# Bandit
BANDIT_BATCH_WINDOW_DAYS=7
BANDIT_REWARD_HORIZON_DEFAULT=30

# Frontends
VITE_API_URL=http://localhost:8000
