# API
PROJECT_NAME="HP Invest API"
VERSION="1.0.0"
DESCRIPTION="API for HP Invest"
BACKEND_CORS_ORIGINS=["http://localhost:4200"]  # Rotas que podem acessar a API
API_PORT=8001

### Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres"
POSTGRES_PORT=5432

# LLM (escolha um)
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
LLM_MODEL=claude-sonnet-4-20250514

# Vector Store (RAG)
CHROMA_PERSIST_DIR=./data/vector_store

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=datathon-mab

# Bandit
BANDIT_BATCH_WINDOW_DAYS=7
BANDIT_REWARD_HORIZON_DEFAULT=30

# Frontends
VITE_API_URL=http://localhost:8000

# Security
SECRET_KEY="your_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redis_password"
REDIS_DB=0

# OpenSearch
OPENSEARCH_HOST="localhost"
OPENSEARCH_PORT=9200
OPENSEARCH_USER="admin"
OPENSEARCH_ADMIN_PASSWORD="Admin@OpenSearch1"

# Neo4j
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="neo4j_password"

# pgAdmin
PGADMIN_EMAIL="admin@datathon.local"
PGADMIN_PASSWORD="pgadmin_password"
